# Copy to .env and change the password. .env is git-ignored.

POSTGRES_USER=yob
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yob

# Used when running the API or worker directly on Windows (cargo run).
# Docker Compose overrides these with the in-network service names.
DATABASE_URL=postgres://yob:change-me@127.0.0.1:5432/yob
REDIS_URL=redis://127.0.0.1:6379

API_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:3000

# Ollama runs as the native Windows app.
OLLAMA_URL=http://127.0.0.1:11434

RUST_LOG=info,api=debug,worker=debug

# Optional: USAJOBS (all US federal jobs open to the public). Get a free key
# at https://developer.usajobs.gov/apirequest/ . USAJOBS requires the email
# you registered with as the User-Agent. Leave blank to skip USAJOBS.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
